ARG BASE_IMAGE=docker.io/tailscale/tailscale:stable@sha256:8c42c4574ab066384fcb72f69e086a2ff1dd3652eb6f56856cee34bcf0d2f680
FROM ${BASE_IMAGE}

# Match openclaw-gateway's `node` user (uid/gid 1000) so `TS_EXTRA_ARGS:
# --operator=node` resolves via getent instead of failing on a bare numeric
# uid, and openclaw-gateway's `tailscale` CLI (uid 1000) gets real operator
# rights for `serve`/`funnel` without needing root/sudo.
RUN addgroup -g 1000 node && adduser -D -H -u 1000 -G node node
